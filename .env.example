# Anti-Fesal (آنتي فصال) - Environment Configuration
# Slogan: "سعّر، بيع، ومن غير وجع فصال"
# Dual-mode architecture: If any key is omitted, graceful local fallbacks are automatically engaged.

# 1. Google AI Studio (Gemini 1.5 Flash Vision & Arabic NLP)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. MongoDB Atlas (Cloud Database - Free Tier or GitHub Student Pack)
# Connection String format: mongodb+srv://<username>:<db_password>@<cluster-host>.mongodb.net/antifesal?retryWrites=true&w=majority
# Fallback: If empty, uses local SQLite (data/antifesal.db)
MONGODB_URI=mongodb+srv://<username>:<db_password>@<cluster-host>.mongodb.net/antifesal?retryWrites=true&w=majority

# 3. Appwrite Cloud Storage (GitHub Student Developer Pack / Appwrite Cloud)
# Endpoint: https://cloud.appwrite.io/v1
# Fallback: If empty, uses local disk storage (data/images/) served via FastAPI static mount
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_BUCKET_ID=your_appwrite_bucket_id
APPWRITE_API_KEY=your_appwrite_api_key

# 4. Clerk Authentication (User Management & Role-Based Access)
# Dashboard: https://dashboard.clerk.com
# Fallback: If empty, uses built-in HMAC-SHA256 session tokens
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# 5. Datadog Pro (US5 - GitHub Student Pack)
# APM & LLM Observability for Anti-Fesal
# Fallback: If empty, telemetry logs locally to logs/automation_log.csv
DD_API_KEY=your_datadog_api_key
DD_SITE=us5.datadoghq.com
DD_LLMOBS_ENABLED=1
DD_LLMOBS_ML_APP=anti-fesal
DD_SERVICE=anti-fesal-backend
DD_ENV=development

# 6. Security, Auth & Portal Gates (Server-Side)
# AUTH_ENFORCE=1 enforces signed Bearer token authentication on protected routes (set 0 ONLY for local X-Dev-Role testing)
AUTH_ENFORCE=1
# Strong random secret for signing HMAC session tokens (set a strong 32+ char secret in production)
SESSION_SECRET=change_me_to_a_strong_random_session_secret
# Portal Gate PINs validated server-side via POST /api/auth/gate
ADMIN_ACCESS_PIN=change_me_admin_pin
CAPTAIN_ACCESS_PIN=change_me_captain_pin

# 7. Deployment & Custom Domain
# Custom Domain claimed from Namecheap (GitHub Student Pack)
CUSTOM_DOMAIN=anti-fesal.me
